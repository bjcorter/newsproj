# Pooled connection (app runtime). Local dev uses the Docker Postgres below.
DATABASE_URL="postgresql://newsproj:newsproj@db:5432/newsproj"

# Direct (non-pooled) connection used by the Prisma CLI for migrations.
# Only needed in production (e.g. Neon). Local dev falls back to DATABASE_URL.
DIRECT_URL=""

# Secret for manually triggering POST /api/ingest (x-ingest-secret header).
INGEST_SECRET=""

# Secret Vercel Cron uses to call GET /api/ingest (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=""

# Auth.js / GitHub OAuth (only needed once auth is added).
AUTH_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""
